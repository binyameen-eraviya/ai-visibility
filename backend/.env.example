# =====================================================================
# Backend environment (fed to the api / worker / beat / db containers via
# docker-compose `env_file: ./backend/.env`). Copy to backend/.env and fill
# in real secrets. This file is committed; backend/.env is gitignored.
# =====================================================================

# ── Runtime mode ─────────────────────────────────────────────────────
# MUST be "production" for `docker compose up`: the app resolves the DB host
# to "db" and the Redis host to "redis" (the compose service names) only when
# ENVIRONMENT=production. Use "development" ONLY when running the API directly
# on your host machine (DB/Redis hosts then resolve to localhost).
ENVIRONMENT=production

# ── App-level dev mode ────────────────────────────────────────────────
# Independent of ENVIRONMENT above (which only controls DB/Redis hostnames).
# When APP_ENV=development, signup auto-verifies the new user (verified_at is
# set immediately) so you can log in without email verification. NEVER set
# this to "development" in a real deployment.
APP_ENV=production

# ── Logging ──────────────────────────────────────────────────────────
# Root log level for the api / worker processes (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────
# Also consumed by the Postgres container itself to initialize the database.
# The async URL is built from these in backend/database/db.py.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aiscope

# ── Auth / JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_TOKEN_EXPIRE_DAYS=5

# ── Redis / Celery ───────────────────────────────────────────────────
# Host "redis" is the compose service name (used inside Docker).
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Scrape storage (Docker volume mounted at /app/storage) ───────────
SCRAPE_STORAGE_DIR=/app/storage/scrapes

# ── Email / SMTP ─────────────────────────────────────────────────────
# REQUIRED: the API raises "SMTP credentials not configured" at startup if
# SMTP_EMAIL or SMTP_APP_PASSWORD is empty. Placeholder values let the app
# boot; real values are only needed to actually send signup/reset emails.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=you@example.com
SMTP_APP_PASSWORD=your-gmail-app-password
FE_URL=http://localhost:3001

# ── Seed super admin (created by `python -m backend.database.seed`) ──
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-admin-password

# ── CORS ─────────────────────────────────────────────────────────────
# Read by main.py. Also injected into the api container by compose from the
# root .env (CORS_ALLOWED_ORIGINS), so keep the two consistent.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ── LLM parsing (used from Milestone 3+) ─────────────────────────────
LLM_API_KEY=your-api-key-here
# Gemini model id (see ListModels). Use a current model — 1.5-flash is retired.
LLM_MODEL=gemini-2.5-flash
