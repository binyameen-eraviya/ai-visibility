# =====================================================================
# Root environment — consumed by docker-compose for ${...} interpolation
# (host ports, CORS, frontend build arg). Copy to .env at the repo root.
# Backend secrets live in backend/.env, NOT here.
# =====================================================================

# Host ports (compose maps host:container, e.g. 8001 -> api:8000)
PORT_BACKEND=8001
PORT_FRONTEND=3001

# Injected into the api container (FE_URL / CORS_ALLOWED_ORIGINS)
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Baked into the frontend image at build time (Vite reads VITE_*)
VITE_API_URL=http://localhost:8001
