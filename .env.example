# ============================================
# AIScope Configuration
# ============================================
# Copy this file to .env and fill in your values
# Never commit .env to git

# ---------- Database ----------
# DATABASE_URL is what the app uses (async). SYNC_DATABASE_URL is used by
# Alembic/tests. Host "db" is the compose service; use "localhost" when
# running outside Docker. POSTGRES_* also initialize the Postgres container.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/aiscope
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/aiscope
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aiscope

# ---------- Auth ----------
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- Redis + Celery ----------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- Gemini API ----------
# Get free keys at https://aistudio.google.com/apikey
# Comma-separated for rotation (recommended: 2-3 keys)
LLM_API_KEYS=key1,key2
LLM_API_KEY=fallback-single-key
LLM_MODEL=gemini-2.0-flash
GEMINI_API_MODEL=gemini-2.0-flash
GEMINI_SCRAPER_API_KEY=

# ---------- Scraping ----------
SCRAPE_STORAGE_DIR=/app/storage/scrapes

# ---------- App ----------
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ---------- Email / SMTP ----------
# Required at boot (placeholders are fine); real values only needed to
# actually send signup/reset emails.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=you@example.com
SMTP_APP_PASSWORD=your-gmail-app-password
FE_URL=http://localhost:3001

# ---------- Seed super admin ----------
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-admin-password

# ---------- Host ports (docker-compose mapping) ----------
PORT_BACKEND=8001
PORT_FRONTEND=3001

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8001

# ---------- Tests (optional) ----------
# TEST_DATABASE_NAME=aiscope_test
